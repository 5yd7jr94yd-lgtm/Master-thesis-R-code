#final: ^210Pb samples ending at 4.5 cm, both fallout markers,
and both radiocarbon dates
```{r}
library(rplum)
library(rbacon)
library(readxl)
library(dplyr)
library(knitr)

coredir <- "Plum_runs"
thick_cm <- 1
sample_depths <- c(seq(0.5, 24.5, by = 1), 25.25)
curve_depths <- seq(0.25, 25, by = 0.25)

dat <- read_excel("TRET25_rplum_simple.xlsx", sheet = "input")

pb_input <- dat |>
  filter(Type == "Pb210") |>
  arrange(Bottom_depth_cm) |>
  transmute(labID = Sample, depth = Bottom_depth_cm,
            density = Density_est_g_cm3,
            Pb210 = Total_Pb210_Bq_kg, error = Total_Pb210_error,
            thickness = Thickness_cm,
            supported = Supported_Pb210_Bq_kg,
            supported_error = Supported_Pb210_error)

c14_input <- dat |>
  filter(Type == "C14") |>
  transmute(labID = Sample, age = C14_age_BP, error = C14_error,
            depth = Mid_depth_cm, cc = 1)

fallout_input <- dat |>
  filter(grepl("^Fallout", Type)) |>
  transmute(labID = Sample, age = C14_age_BP, error = C14_error,
            depth = Mid_depth_cm, cc = 0)

age_at <- function(d) {
  ages <- Bacon.Age.d(d, set = info, BCAD = FALSE)
  ages <- ages[is.finite(ages)]
  data.frame(depth_cm = d,
             median_cal_yr_BP = median(ages),
             lower95_cal_yr_BP = unname(quantile(ages, 0.025)),
             upper95_cal_yr_BP = unname(quantile(ages, 0.975)))
}
```
## Fit final model
```{r}
#| fig-width: 11
#| fig-height: 7
core <- "Agemodel_pb45_markers"
folder <- file.path(coredir, core)
dir.create(folder, recursive = TRUE, showWarnings = FALSE)

pb_final <- pb_input |> filter(depth <= 4.5)
dates_final <- bind_rows(c14_input, fallout_input) |> arrange(depth)

write.csv(pb_final, file.path(folder, paste0(core, ".csv")), row.names = FALSE)
dates_file <- paste0(core, "_C14.csv")
write.csv(dates_final, file.path(folder, dates_file), row.names = FALSE)

Plum(core = core, coredir = coredir, otherdates = dates_file,
     date.sample = 2025, ra.case = 2, n.supp = 0, Bqkg = TRUE,
     cc1 = "IntCal20", BCAD = FALSE,
     thick = thick_cm, acc.mean = 30,
     d.min = 0, d.max = 25.25, d.by = 0.5,
     remember = FALSE, ask = FALSE, suggest = FALSE,
     plot.pdf = FALSE)
```
## Figure cleaner version
```{r}
#| fig-width: 12
#| fig-height: 5.5

library(ggplot2)
library(dplyr)
library(patchwork)

# 1. Prepare unsupported 210Pb activity
pb_plot <- pb_input |>
  transmute(
    depth = depth,
    activity = Pb210 - supported,
    error = sqrt(error^2 + supported_error^2)
  ) |>
  filter(depth <= 4.5) |>
  arrange(depth)

# 2. Create a transparent purple activity profile
p_pb_ghost <- ggplot(pb_plot,
  aes(x = depth, y = activity)) +

  # Measurement uncertainty
  geom_errorbar(aes(ymin = activity - error,ymax = activity + error),
    colour = "midnightblue",
    alpha = 0.35,
    linewidth = 0.4,
    width = 0.08) +

  # Activity profile
  geom_line(colour = "midnightblue",alpha = 0.45,linewidth = 0.6) +

  # Activity measurements
  geom_point(colour = "midnightblue",alpha = 0.65,size = 1.8) +

  # Independent activity scale
  scale_x_continuous(limits = c(0, 4.5),breaks = NULL,expand = c(0, 0)) +

  scale_y_continuous(breaks = seq(0, 500, 100),expand = expansion(mult = c(0.05, 0.1))) +
labs(x = NULL,y = expression({}^{210}*"Pb(Bq/kg)")) +
theme_classic(base_size = 8) +
theme(
    axis.title.x = element_blank(),
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),

    axis.title.y = element_text(size = 7,colour = "midnightblue"),
    axis.text.y = element_text(size = 7,colour = "midnightblue"),
    axis.ticks.y = element_line(colour = "midnightblue",linewidth = 0.3),

axis.line.y = element_line(colour = "midnightblue",linewidth = 0.3),
axis.line.x = element_blank(),panel.background = element_rect(fill = NA,colour = NA),

    plot.background = element_rect(fill = NA,colour = NA),
    plot.margin = margin(2, 2, 2, 2))

# 3. Overlay Pb activity on the shallow section
age_plot_pb <- age_plot_broken + inset_element(
    p_pb_ghost,
    left = 0.00,
    bottom = 0.08,
    right = 0.22,
    top = 0.34,
    align_to = "panel",
    clip = TRUE)
age_plot_pb

# 5. Save high-resolution figure
ggsave("TRET25_age_depth_all_dating_evidence.png",
  plot = age_plot_pb,
  width = 12,
  height = 5.5,
  dpi = 600,
  bg = "white")

ggsave("TRET25_age_depth_all_dating_evidence.pdf",
